{
  "name": "gureevdoc",
  "version": "0.3.2",
  "description": "Офлайн-реестр строительных объектов, договоров и документов",
  "main": "src/main/main.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:demo": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 GUREEVDOC_RESET_DEMO=1 electron .\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "rebuild": "cd node_modules/better-sqlite3 && npx prebuild-install --runtime electron --target 37.10.3"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "adm-zip": "0.6.0",
    "better-sqlite3": "12.11.1",
    "csv-parse": "6.1.0",
    "csv-stringify": "6.6.0",
    "lucide-react": "0.542.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "vite": "7.3.6",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "ru.local.gureevdoc",
    "productName": "GureevDoc",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
